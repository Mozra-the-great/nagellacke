# Refuse to install on a Node that package.json "engines" does not allow, instead
# of warning and carrying on. The in-app self-update resets an existing install
# to the new checkout and then runs `npm install` here: on a host still running
# Node 20/22 this makes the update stop at that step with an EBADENGINE message
# naming the required version, rather than breaking later in the tsup/vite build.
engine-strict=true
